# ==========================================
# 智能销售 AI Agent - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ==========================================

# ========== 应用基础配置 ==========
APP_NAME=智能销售 AI Agent
APP_VERSION=1.0.0
DEBUG=true

# API 配置
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# CORS 配置（微信小程序域名）
CORS_ORIGINS=["*"]
# 生产环境示例：
# CORS_ORIGINS=["https://servicewechat.com", "https://your-domain.com"]

# ========== LLM 配置 ==========
# OpenAI API（优先）
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# 如果使用代理或第三方 API：
# OPENAI_BASE_URL=https://api.moonshot.cn/v1  # 月之暗面
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # 阿里云

DEFAULT_MODEL=gpt-4o-mini
# 可选模型：gpt-4o, gpt-4-turbo, claude-3-opus-20240229 等

# ========== LangGraph 配置 ==========
MAX_ITERATIONS=10

# ========== 知识库配置 ==========
KNOWLEDGE_BASE_PATH=./data/knowledge_base
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=text-embedding-3-small

# ========== 文档输出配置 ==========
OUTPUT_DIR=./output

# ========== 日志配置 ==========
LOG_LEVEL=INFO
# 可选：DEBUG, INFO, WARNING, ERROR, CRITICAL

# ========== 微信小程序配置（预留） ==========
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret
# WECHAT_TOKEN_URL=https://api.weixin.qq.com/sns/jscode2session

# ========== 数据库配置（预留） ==========
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/sales_ai
# REDIS_URL=redis://localhost:6379/0
